# Server port (AI Studio uses port 3000)
PORT=3000

# Firebase public client config is loaded directly from firebase-applet-config.json
# (no Firebase secret key or environment variable is required).

# Optional: OneSignal Push (required for Median.co Android wrapper real-time push notifications on Vercel)
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=

# Optional: Web Push VAPID keys for browser / installed Chrome PWA on Vercel
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:notifications@hour.app

        "paperStyle": {
          "type": "string",
          "enum": ["ruled-yellow", "plain-cream", "ruled-white", "plain-white", "plain-night", "dot-cream", "grid-sage", "ruled-parchment"]
        },
        "inkStyle": { "type": "string", "enum": ["serif", "sans", "mono"] },
        "fontSize": { "type": "string", "enum": ["sm", "md", "lg"] },
        "template": { "type": "string", "enum": ["", "free", "debrief", "wins", "reset"] },
        "starred": { "type": "boolean" },
        "energy": { "type": "number", "minimum": 0, "maximum": 5 },
        "dayRating": { "type": "number", "minimum": 0, "maximum": 5 },
        "tags": { "type": "array" },
        "gratitude": { "type": "array" },
        "promptQ": { "type": "string", "maxLength": 160 },
        "promptA": { "type": "string", "maxLength": 500 },
        "focusMinutes": { "type": "number", "minimum": 0, "maximum": 1440 },
        "questionsSolved": { "type": "number", "minimum": 0, "maximum": 2000 },
        "leftOnTime": { "type": "number", "minimum": 0, "maximum": 2000 },
        "overtimeSkips": { "type": "number", "minimum": 0, "maximum": 2000 },
        "tasksDone": { "type": "number", "minimum": 0, "maximum": 500 },
        "wordCount": { "type": "number", "minimum": 0, "maximum": 3000 },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "dateKey",
        "title",
        "body",
        "highlight",
        "tomorrowGoal",
        "mood",
        "paperStyle",
        "inkStyle",
        "focusMinutes",
        "questionsSolved",
        "tasksDone",
        "wordCount",
        "createdAtMs",
        "updatedAtMs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/players/{userId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Public competitive player stats and rankings (no PII)."
    },
    "/players/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Per-player deduplicated timer activity ledger."
    },
    "/players/{userId}/backup/{backupId}": {
      "schema": { "$ref": "#/entities/AccountBackup" },
      "description": "Private owner-only full account progress snapshot across all study tools."
    },
    "/players/{userId}/diary/{entryId}": {
      "schema": { "$ref": "#/entities/DiaryEntry" },
      "description": "Private owner-only daily diary pad entries keyed by YYYY-MM-DD."
    },
    "/rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/ArenaRoom" },
      "description": "Multiplayer study rooms and 1v1 timed sprint rooms."
    },
    "/rooms/{roomCode}/participants/{participantUid}": {
      "schema": { "$ref": "#/entities/RoomParticipant" },
      "description": "Live standings and readiness per participant inside a room."
    },
    "/rooms/{roomCode}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Ephemeral session chat & rivalry messages deleted automatically when session ends."
    },
    "/friendships/{pairId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Pending and accepted friend relationships between two players."
    },
    "/friendInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/FriendInvite" },
      "description": "Real-time Arena room invitations sent between friends."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/PlayerStory" },
      "description": "24-hour Instagram-style stories scoped strictly to author and accepted friends via viewerUids."
    },
    "/stories/{storyId}/views/{viewerUid}": {
      "schema": { "$ref": "#/entities/StoryView" },
      "description": "Per-viewer story seen receipts."
    },
    "/stories/{storyId}/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/StoryReaction" },
      "description": "Live story emoji reactions and replies from friends."
    }
  }
}

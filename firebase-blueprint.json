          "type": "string",
          "maxLength": 28000,
          "pattern": "^(|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$"
        },
        "avatarPreset": {
          "type": "string",
          "maxLength": 16
        },
        "statusBadge": {
          "type": "string",
          "maxLength": 24

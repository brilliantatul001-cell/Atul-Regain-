          "type": "string",
          "maxLength": 48
        },
        "dailyGoalMin": { "type": "number" },
        "studySlot": {
          "type": "string",
          "maxLength": 28
        },
        "strongSubject": {
          "type": "string",
          "maxLength": 24
        },
        "weakSubject": {
          "type": "string",
          "maxLength": 24
        },
        "studyStyle": {
          "type": "string",
          "maxLength": 24
        },
        "isOnline": { "type": "boolean" },
        "lastSeenAtMs": { "type": "number" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
